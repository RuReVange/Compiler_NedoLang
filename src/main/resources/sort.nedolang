function generateArray(size) {
    var arr = [];
    var i = 0;
    while (i < size) {
        arr[i] = randomInt(0, 100000);
        i = i + 1;
    }
    return arr;
}

function quickSort(arr) {
    if (length(arr) <= 1) {
        return arr;
    } else {
        var pivot = arr[0];
        var less = [];
        var greater = [];
        var i = 1;
        while (i < length(arr)) {
            if (arr[i] <= pivot) {
                less.push(arr[i]);
            } else {
                greater.push(arr[i]);
            }
            i = i + 1;
        }
        return quickSort(less) + [pivot] + quickSort(greater);
    }
}

var array = generateArray(10000);
var sortedArray = quickSort(array);
print(sortedArray);
