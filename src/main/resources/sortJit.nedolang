function generateArray(size) {
    var arr = [];
    var i = 0;
    while (i < size) {
        arr[i] = randomInt(0, 100000);
        i = i + 1;
    }
    return arr;
}

function quickSort(arr) {
    if (length(arr) <= 1) {
        return arr;
    }

    var pivot = arr[0];
    var less = [];
    var greater = [];
    var i = 1;

    while (i < length(arr)) {
        if (arr[i] <= pivot) {
            push(less, arr[i]);
        } else {
            push(greater, arr[i]);
        }
        i = i + 1;
    }

    var sortedLess = quickSort(less);
    var sortedGreater = quickSort(greater);

    var result = [];

    i = 0;
    while (i < length(sortedLess)) {
        push(result, sortedLess[i]);
        i = i + 1;
    }

    push(result, pivot);

    i = 0;
    while (i < length(sortedGreater)) {
        push(result, sortedGreater[i]);
        i = i + 1;
    }

    return result;
}

var arr = generateArray(10000);

var i = 0;
while (i < 100) {
    quickSort(arr);
    i = i + 1;
}